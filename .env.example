# Copy to .env and fill in. Never commit .env -- it is gitignored.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every live session, invite link and passcode.
SECRET_KEY=change-me

# Which domains count as Columbia.
ALLOWED_EMAIL_DOMAINS=columbia.edu,gsb.columbia.edu,cumc.columbia.edu,tc.columbia.edu

# ---------------------------------------------------------------------------
# Email
#
#   file  -- writes each message to instance/outbox/ AND prints it to the
#            terminal. Sends nothing. Use this while developing.
#   smtp  -- really sends. This is the pilot setting.
#
MAIL_BACKEND=file

# --- Pilot delivery: a Gmail account with an app password -------------------
# Enough for a few hundred Columbia recipients and needs no sender domain.
#
#   1. Turn on 2-Step Verification on the sending Google account.
#   2. Create an app password: myaccount.google.com/apppasswords
#   3. Paste the 16-character password below (spaces are fine) and set
#      MAIL_BACKEND=smtp.
#
# Gmail caps at ~500 recipients a day, and mail from a personal address can
# land in spam. Fine for the pilot; revisit before any real launch.
MAIL_FROM=MarketPlace <your.account@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.account@gmail.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
