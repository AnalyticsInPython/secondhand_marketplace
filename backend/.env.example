# Copy to backend/.env and adjust. Everything has a working default for local dev.

# SQLite for local work; swap to Postgres without changing any code:
#   DATABASE_URL=postgresql+psycopg://user:pass@host/dbname
# Default: sqlite:///<backend dir>/columbia_market.db

# Where the frontend runs (CORS + sign-in links) and where this API is reachable
# (used to build absolute photo URLs).
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_ORIGIN=http://localhost:8000
COOKIE_SECURE=false

# Membership rule. Everything about the product depends on this one line.
# The four domains agreed by the team on 2026-09-02 (docs/DECISIONS.md).
ALLOWED_EMAIL_DOMAINS=columbia.edu,gsb.columbia.edu,cumc.columbia.edu,tc.columbia.edu

# --- Sign-in email -----------------------------------------------------------
# console  print the link to the server log (local dev)
# resend   Resend HTTP API: needs RESEND_API_KEY and a verified EMAIL_FROM
# smtp     any SMTP relay: SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD
EMAIL_BACKEND=console
# In dev the sign-in link is also returned in the API response and shown on the
# sign-in screen, so you can click through without an inbox. Never in production.
EMAIL_DEV_MODE=true
EMAIL_FROM="Columbia Market <no-reply@columbiamarket.app>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Research ----------------------------------------------------------------
# When true, half of feed impressions hide match badges and the choice is
# recorded on listing_views.badges_shown (analytics Q1).
BADGE_EXPERIMENT_ENABLED=false
