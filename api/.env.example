# Copy to api/.env and fill in. Never commit .env.

# Which addresses may create an account. Config, not code -- opening LionsList
# to another Columbia school is an environment change and a redeploy.
# Launch set, per build spec step 03:
ALLOWED_EMAIL_DOMAINS=columbia.edu,gsb.columbia.edu

# --- Supabase --------------------------------------------------------------
# Project settings -> API. Use the DEV project locally; prod only on main.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# --- Postgres --------------------------------------------------------------
# Project settings -> Database -> Connection string (session pooler).
DATABASE_URL=postgresql+psycopg://postgres:<password>@<host>:5432/postgres

# --- CORS ------------------------------------------------------------------
# The Vercel domains only. Never "*".
CORS_ORIGINS=http://localhost:3000
